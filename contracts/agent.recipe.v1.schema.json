{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eclipse-forge.ru/contracts/agent.recipe.v1.schema.json",
  "title": "Eclipse Agent Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "owner", "purpose", "source", "framework", "permissions", "data", "evaluation", "budget", "lifecycle"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96 },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "owner": { "type": "string", "minLength": 2, "maxLength": 120 },
    "purpose": { "type": "string", "minLength": 20, "maxLength": 500 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "license", "revision", "verifiedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 2, "maxLength": 120 },
        "revision": { "type": "string", "minLength": 7, "maxLength": 128 },
        "verifiedAt": { "type": "string", "format": "date" }
      }
    },
    "framework": { "enum": ["native", "langgraph", "crewai", "autogen", "agno", "llamaindex", "other"] },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "readPaths", "writePaths", "tools"],
      "properties": {
        "network": { "enum": ["deny", "allowlist"] },
        "networkAllowlist": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "format": "hostname" } },
        "readPaths": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "writePaths": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "tools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source", "descriptionHash", "approved"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$", "maxLength": 128 },
              "source": { "type": "string", "format": "uri" },
              "descriptionHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "approved": { "const": true }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "containsSensitiveData", "retentionDays"],
      "properties": {
        "classes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 80 } },
        "containsSensitiveData": { "type": "boolean" },
        "retentionDays": { "type": "integer", "minimum": 0, "maximum": 365 }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "successCriteria", "humanReviewRequired"],
      "properties": {
        "fixture": { "type": "string", "minLength": 1, "maxLength": 240 },
        "successCriteria": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 5, "maxLength": 240 } },
        "humanReviewRequired": { "const": true }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "hardLimit"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "hardLimit": { "type": "number", "minimum": 0, "maximum": 100000 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["quarantine", "review", "approved", "retired"] },
        "reviewedBy": { "type": "string", "minLength": 2, "maxLength": 120 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
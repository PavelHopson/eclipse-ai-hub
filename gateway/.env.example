AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=8810
AI_GATEWAY_SERVICE_TOKEN=generate-a-random-secret-with-at-least-32-characters
# For multiple products, replace the legacy token above with one JSON array.
# Keep the value single-quoted when this file is sourced by a shell.
# AI_GATEWAY_SERVICE_CLIENTS='[{"id":"eclipse-chat","tokens":["replace-with-32-plus-char-token"],"scopes":["models:read","telemetry:read","chat:write"],"requestsPerMinute":90},{"id":"eclipse-chat-growth","tokens":["replace-with-another-32-plus-char-token"],"scopes":["growth:execute"],"requestsPerMinute":30}]'

# OpenAI-compatible upstream. Plain HTTP is accepted only for localhost.
AI_GATEWAY_UPSTREAM_BASE_URL=http://127.0.0.1:20128/api/v1
AI_GATEWAY_UPSTREAM_API_KEY=replace-with-upstream-key-if-required
AI_GATEWAY_MODELS=auto/best-chat
# Optional bounded provider router. If set, this replaces the two legacy upstream variables above.
# Secrets are referenced by environment-variable name and never embedded in the JSON value.
# OMNIROUTE_API_KEY=replace-with-server-side-secret
# AI_GATEWAY_UPSTREAMS='[{"id":"omniroute","baseUrl":"https://router.example.com/v1","apiKeyEnv":"OMNIROUTE_API_KEY","models":["auto/best-chat"],"priority":0,"monthlyTokenBudget":1500000000},{"id":"ollama-local","baseUrl":"http://127.0.0.1:11434/v1","models":["auto/best-chat"],"priority":1,"monthlyTokenBudget":null}]'
# Total attempts per provider, including the first request (1..3).
AI_GATEWAY_PROVIDER_RETRY_ATTEMPTS=2

# Opt-in fixed GPT-5.6 Responses router. Give only approved callers responses:write.
AI_GATEWAY_GPT56_ROUTER_ENABLED=false

AI_GATEWAY_TIMEOUT_MS=60000
AI_GATEWAY_MAX_BODY_BYTES=524288
AI_GATEWAY_REQUESTS_PER_MINUTE=120

# Aggregate-only SLO telemetry. No prompt, response or request identifiers.
AI_GATEWAY_TELEMETRY_FILE=/var/lib/eclipse-ai-gateway/telemetry.json
AI_GATEWAY_TELEMETRY_RETENTION_HOURS=168
AI_GATEWAY_SLO_AVAILABILITY_PERCENT=99
AI_GATEWAY_SLO_P95_LATENCY_MS=15000
